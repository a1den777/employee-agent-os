# 供应商适配器可以使用自己的环境变量。
# 核心框架不要求 API Key；Claude Code 会自行管理登录认证。
AGENT_PROVIDER=
AGENT_MODEL=
# 飞书凭证只通过环境变量注入，不要提交真实值。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Vault MCP service
VAULT_ROOT=./vault
VAULT_HOST=127.0.0.1
VAULT_PORT=8787
VAULT_MCP_PATH=/mcp
VAULT_TOKEN=
# Or use a JSON map, for example:
# VAULT_TOKENS={"admin":"replace-me","member-001":{"token":"replace-me","role":"member"}}
VAULT_TOKENS=
